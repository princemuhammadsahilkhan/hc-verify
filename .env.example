# Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=hvverify
DB_PORT=8090

# Database URL used by FastAPI backend container (db is the service name in docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:root@db:5432/hvverify

# Admin Configurations
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin
RECOVERY_KEY_HASH=c847c7ea23e48e39d9d92040376c2d1752f1e8fd86bae4e986dc29f729ce9233
ADMIN_EMAIL=admin@example.com

# SMTP Configurations
SMTP_USER=smtp@example.com
SMTP_PASS=smtp_password

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost
